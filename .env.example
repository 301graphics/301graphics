# Copy to .env.local for local dev. On Vercel, add these under Project > Settings > Environment Variables.

# Optional: Resend (resend.com, free tier) delivers quote requests WITH photo attachments. Without it, requests go through the Formspree form set in data/site.js (text only).
RESEND_API_KEY=
# Where quote requests are delivered
QUOTE_TO_EMAIL=301graphic@gmail.com
# "From" address. Use onboarding@resend.dev until 301graphics.com is verified in Resend, then quotes@301graphics.com
QUOTE_FROM_EMAIL=301 Graphics Website <onboarding@resend.dev>

# Scheduling (Calendly event link, e.g. https://calendly.com/301graphics/site-survey). Leave blank to hide the booking panel.
NEXT_PUBLIC_CALENDLY_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google Business Profile links
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://www.google.com/maps?cid=13903693235106248183
NEXT_PUBLIC_GOOGLE_WRITE_REVIEW_URL=

# Optional Instagram feed embed script URL from behold.so (free). Leave blank to show the built-in gallery instead.
NEXT_PUBLIC_INSTAGRAM_FEED_ID=
